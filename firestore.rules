rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().data.role == 'ADMIN';
    }
    
    function isManagement() {
      return isAuthenticated() && (getUserData().data.role == 'MANAGEMENT' || getUserData().data.role == 'ADMIN');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManagement());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Players Collection
    match /players/{playerId} {
      allow read: if true;
      allow create: if isManagement() || (isAuthenticated() && request.auth.uid == request.resource.data.userId);
      allow update: if isManagement() || 
        (isAuthenticated() && request.auth.uid == resource.data.userId) ||
        (isAuthenticated() && !("userId" in resource.data) && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Teams
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isManagement();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if true; 
      allow write: if isManagement();
    }
    
    // Match Performances
    match /matchPerformances/{perfId} {
      allow read: if true;
      allow write: if isManagement();
    }

    // Tournaments, Series, Special Series
    match /tournaments/{tourId} { allow read: if true; allow write: if isManagement(); }
    match /series/{seriesId} { allow read: if true; allow write: if isManagement(); }
    match /specialSeries/{seriesId} { allow read: if true; allow write: if isManagement(); }

    // Notices, News, Announcements
    match /notices/{noticeId} { allow read: if true; allow write: if isManagement(); }
    match /news/{newsId} { allow read: if true; allow write: if isManagement(); }
    match /announcements/{annId} { allow read: if true; allow write: if isManagement(); }

    // Gallery
    match /gallery/{imageId} { allow read: if true; allow write: if isManagement(); }

    // Player of the Month
    match /playerOfMonth/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Settings
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Club Stats
    match /clubStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (legacy)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
